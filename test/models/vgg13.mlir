    %80 = stablehlo.reshape %79 : (tensor<1xf32>) -> tensor<1x1xf32> loc(#loc61)
    %81 = stablehlo.broadcast_in_dim %80, dims = [0, 1] : (tensor<1x1xf32>) -> tensor<1x1000xf32> loc(#loc61)
    %82 = stablehlo.divide %78, %81 : tensor<1x1000xf32> loc(#loc61)
    return %82 : tensor<1x1000xf32> loc(#loc)
  } loc(#loc1)
} loc(#loc)
